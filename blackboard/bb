#!/usr/bin/env bash
# Blackboard helper. See PROTOCOL.md in this directory.
set -euo pipefail
export LC_ALL=C

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REGISTRY="$ROOT/registry.md"
AGENTS_DIR="$ROOT/agents"

usage() {
  cat <<'EOF'
Usage:
  bb register <name> "<role>"
  bb log <name> <kind> "<text>"
  bb log <name> <kind> -          (read text from stdin, for multi-line)
  bb who
  bb read <name> [--all]
EOF
  exit 1
}

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

valid_name() { [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]]; }

cmd_register() {
  local name="$1" role="$2"
  valid_name "$name" || { echo "bb: invalid name '$name' (lowercase letters, digits, dashes)" >&2; exit 1; }
  if [[ -d "$AGENTS_DIR/$name" ]]; then
    echo "bb: '$name' is already registered — run 'bb who' and pick another name" >&2
    exit 1
  fi
  mkdir -p "$AGENTS_DIR/$name"
  : > "$AGENTS_DIR/$name/wm-log.md"
  : > "$AGENTS_DIR/$name/.cursors"
  if [[ ! -f "$REGISTRY" ]]; then
    printf '# Agent Registry\n\n| Name | Role | Cwd | Registered (UTC) |\n|---|---|---|---|\n' > "$REGISTRY"
  fi
  printf '| %s | %s | %s | %s |\n' "$name" "$role" "$(pwd)" "$(now)" >> "$REGISTRY"
  echo "registered '$name'"
}

cmd_log() {
  local name="$1" kind="$2" text="$3"
  [[ -d "$AGENTS_DIR/$name" ]] || { echo "bb: '$name' is not registered — run 'bb register' first" >&2; exit 1; }
  if [[ "$text" == "-" ]]; then
    text="$(cat)"
  fi
  {
    printf '### %s %s %s\n' "$(now)" "$name" "$kind"
    printf '%s\n\n' "$text"
  } >> "$AGENTS_DIR/$name/wm-log.md"
}

cmd_who() {
  if [[ -f "$REGISTRY" ]]; then cat "$REGISTRY"; else echo "(no one registered yet)"; fi
}

cmd_read() {
  # Cursors are entry counts per peer, not timestamps: two log entries can
  # land in the same wall-clock second, and a strict timestamp '>' comparison
  # would silently skip the second one. Counting header lines avoids that.
  local name="$1" all="${2:-}"
  [[ -d "$AGENTS_DIR/$name" ]] || { echo "bb: '$name' is not registered — run 'bb register' first" >&2; exit 1; }
  local cursors="$AGENTS_DIR/$name/.cursors"
  local tmp; tmp="$(mktemp)"
  [[ -f "$cursors" ]] && cp "$cursors" "$tmp" || : > "$tmp"
  local found_any=0

  for peer_dir in "$AGENTS_DIR"/*/; do
    local peer; peer="$(basename "$peer_dir")"
    [[ "$peer" == "$name" ]] && continue
    local logfile="$peer_dir/wm-log.md"
    [[ -f "$logfile" ]] || continue

    local since=0
    if [[ "$all" != "--all" ]]; then
      local recorded
      recorded="$(awk -F'\t' -v p="$peer" '$1==p{c=$2} END{print c}' "$cursors" 2>/dev/null || true)"
      [[ -n "$recorded" ]] && since="$recorded"
    fi

    local total
    total="$(grep -c '^### ' "$logfile" || true)"
    [[ -z "$total" ]] && total=0

    if [[ "$total" -gt "$since" ]]; then
      found_any=1
      awk -v since="$since" -v nm="$name" '
        /^### / { n++; if (n>since) { print "---"; print }; next }
        { if (n>since) { print; if (index($0, "@"nm) > 0) print "    (mentions you)" } }
      ' "$logfile"

      awk -F'\t' -v p="$peer" -v c="$total" '
        $1==p { print p"\t"c; done=1; next }
        { print }
        END { if (!done) print p"\t"c }
      ' "$tmp" > "$tmp.new" && mv "$tmp.new" "$tmp"
    fi
  done

  mv "$tmp" "$cursors"
  [[ "$found_any" == "0" ]] && echo "(nothing new)"
  return 0
}

case "${1:-}" in
  register) shift; [[ $# -eq 2 ]] || usage; cmd_register "$1" "$2" ;;
  log)      shift; [[ $# -eq 3 ]] || usage; cmd_log "$1" "$2" "$3" ;;
  who)      cmd_who ;;
  read)     shift; [[ $# -ge 1 ]] || usage; cmd_read "$1" "${2:-}" ;;
  *) usage ;;
esac
